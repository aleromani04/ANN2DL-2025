dden_size * 2\n","        else:\n","            classifier_input_size = hidden_size\n","\n","        self.classifier = nn.Sequential(\n","            nn.Linear(classifier_input_size, hidden_size_classifier),\n","            nn.ReLU(),\n","            nn.Dropout(p=dropout_rate),\n","            nn.Linear(hidden_size_classifier, num_classes)\n","        )\n","\n","    def forward(self, x):\n","        x = x.to(torch.float32)\n","        rnn_out, hidden = self.rnn(x)\n","\n","        if self.rnn_type == 'LSTM':\n","            hidden = hidden[0]\n","\n","        if self.bidirectional:\n","            hidden = hidden.view(self.num_layers, 2, -1, self.hidden_size)\n","            hidden_to_classify = torch.cat([hidden[-1, 0, :, :], hidden[-1, 1, :, :]], dim=1)\n","        else:\n","            hidden_to_classify = hidden[-1]\n","\n","        logits = self.classifier(hidden_to_classify)\n","        return logits\n","\n","# Funzione per creare i DataLoader, spostata qui per self-containment\n","def make_loader(ds, batch_size, shuffle, drop_last):\n","    # Determina il numero ottimale di processi worker per il caricamento dei dati\n","    cpu_cores = os.cpu_count() or 2\n","    num_workers = max(2, min(4, cpu_cores))\n","\n","    # Crea DataLoader con ottimizzazioni delle prestazioni\n","    return DataLoader(\n","        ds,\n","        batch_size=batch_size,\n","        shuffle=shuffle,\n","        drop_last=drop_last,\n","        num_workers=num_workers,\n","        pin_memory=True,  # Trasferimento più rapido alla GPU\n","        pin_memory_device=\"cuda\" if torch.cuda.is_available() else \"\",\n","        prefetch_factor=4,  # Carica 4 batch in anticipo\n","    )\n","\n","\n","# Feature columns definition\n","feature_columns = scale_columns + [\"pain_survey_1\", \"pain_survey_2\", \"pain_survey_3\", \"pain_survey_4\", \"n_legs\", \"n_hands\", \"n_eyes\"]\n","\n","# input_size for the model\n","input_size = len(feature_columns)\n","\n","# Generating all the subsequences of X_test using build_sequences_test\n","# X_test has been already preprocessed in the previous cells\n","\n","print(\"Generating all the subsequences of X_test...\")\n","X_test_all_windowed = build_sequences_test(X_test, window=WINDOW_SIZE, stride=STRIDE)\n","\n","# converting in numpy array\n","X_test_all_windowed = np.array(X_test_all_windowed)\n","\n","print(f\"Total number of subsequences generated for the dataset: {X_test_all_windowed.shape[0]}\")\n","print(f\"Shape of a subsequence: {X_test_all_windowed.shape[1:]}\")\n","\n","# Create the dataloader for all the subsequences\n","all_sequences_ds = TensorDataset(torch.from_numpy(X_test_all_windowed))\n","all_sequences_loader = make_loader(\n","  all_sequences_ds,\n","  batch_size=BATCH_SIZE,\n","  shuffle=False,\n","  drop_last=False\n",")\n","\n","# Predictions on all the subsequences\n","print(\"Executing predictions on all the subsequences...\")\n","\n","device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n","\n","# Architecture Parameters (to load the already trained model)\n","HIDDEN_LAYERS = 2\n","HIDDEN_SIZE = 128\n","DROPOUT_RATE = 0.4\n","HIDDEN_SIZE_CLASSIFIER = 8\n","num_classes = 3\n","BIDIRECTIONAL = False\n","RNN_TYPE = 'LSTM'\n","\n","# Create an instance of the model\n","rnn_model = RecurrentClassifier(\n","    input_size=input_shape[-1],\n","    hidden_size=HIDDEN_SIZE,\n","    hidden_size_classifier = HIDDEN_SIZE_CLASSIFIER,\n","    num_layers=HIDDEN_LAYERS,\n","    num_classes=num_classes,\n","    dropout_rate=DROPOUT_RATE,\n","    bidirectional=False,\n","    rnn_type='LSTM'\n","    ).to(device)\n","recurrent_summary(rnn_model, input_size=input_shape)\n","\n","# Load the trained model\n","model_path = 'models/lstm_augmented_CONSEGNA.pt'\n","\n","try:\n","    rnn_model.load_state_dict(torch.load(model_path, map_location=device))\n","    print(f\"Stato del modello caricato con successo da '{model_path}'.\")\n","except FileNotFoundError:\n","    print(f\"Errore: '{model_path}' non trovato. Assicurati che il file del modello sia nella posizione corretta.\")\n","    exit()\n","except Exception as e:\n","    print(f\"Si è verificato un errore durante il caricamento dello stato del modello: {e}\")\n","    exit()\n","\n","rnn_model.eval() # Model in evaluation mode\n","\n","all_flat_predictions = []\n","with torch.no_grad():\n","    for inputs in all_sequences_loader:\n","        inputs = inputs[0].to(device)\n","        outputs = rnn_model(inputs)\n","        _, predicted_classes = torch.max(outputs, 1)\n","        all_flat_predictions.extend(predicted_classes.cpu().numpy().tolist())\n","\n","all_flat_predictions = np.array(all_flat_predictions)\n","\n","# Defining the selected subsequences pfor Majority Voting and Tie-breaking ---\n","# Each subsequence MUST have length equale to WINDOW_SIZE.\n","# start_timestep - 1 must be a multiple of STRIDE (10).\n","subsequences_for_voting = [\n","    (51, 80),\n","    (61, 90),\n","    (71, 100),\n","    (81, 110)\n","\n","]\n","\n","#Defining the preferential subsequence in case of a tie\n","preferential_subsequence = (61, 90)\n","\n","# Get unique sample indices from the test set\n","unique_users = X_test['sample_index'].unique()\n","original_sample_len = 160\n","\n","#Calculate the number of subsequences generated in the test for each sample\n","padding_len_per_sample = WINDOW_SIZE - (original_sample_len % WINDOW_SIZE)\n","if padding_len_per_sample == WINDOW_SIZE:\n","    padding_len_per_sample = 0\n","padded_len_per_sample = original_sample_len + padding_len_per_sample\n","total_subsequences_per_original_sample = int(floor((padded_len_per_sample - WINDOW_SIZE) / STRIDE) + 1)\n","\n","final_predictions = []\n","from collections import Counter\n","\n","print(\"Applicazione del Majority Voting e Tie-breaking...\")\n","for i, sample_id in enumerate(unique_users):\n","    # Predictions for the current sample from all the subsequences\n","    sample_predictions_start_idx = i * total_subsequences_per_original_sample\n","    sample_predictions_end_idx = sample_predictions_start_idx + total_subsequences_per_original_sample\n","    current_sample_all_predictions = all_flat_predictions[sample_predictions_start_idx:sample_predictions_end_idx]\n","\n","    # We store the predictions to use for voting\n","    votes = []\n","    for start_ts_1idx, end_ts_1idx in subsequences_for_voting:\n","        start_ts_0idx = start_ts_1idx - 1\n","        # Compute the index k of the subsequence relative to the sample\n","        # This k is the index of the subsequence in 'total_subsequences_per_original_sample'\n","        relative_subsequence_k = start_ts_0idx // STRIDE\n","\n","        if relative_subsequence_k < len(current_sample_all_predictions):\n","            votes.append(current_sample_all_predictions[relative_subsequence_k])\n","        else:\n","            # This case shouldn't happen if the subsequences are correctly defined\n","            print(f\"Attenzione: Sottosequenza di voting (start_ts={start_ts_1idx}) fuori dai limiti per sample_id {sample_id}.\")\n","\n","    # Count the votes for each class\n","    vote_counts = Counter(votes)\n","\n","    # Find the maximum of the votes\n","    max_votes = 0\n","    if vote_counts:\n","        max_votes = max(vote_counts.values())\n","\n","    # Classes with the max number of votes\n","    majority_classes = [cls for cls, count in vote_counts.items() if count == max_votes]\n","\n","    if len(majority_classes) == 1:\n","        # No tie, we choose the most voted for class\n","        final_predictions.append(majority_classes[0])\n","    else:\n","        # Ther is a tie: we use the prediction of the preferential subsequence\n","        pref_start_ts_1idx, _ = preferential_subsequence\n","        pref_start_ts_0idx = pref_start_ts_1idx - 1\n","        relative_pref_subsequence_k = pref_start_ts_0idx // STRIDE\n","\n","        if relative_pref_subsequence_k < len(current_sample_all_predictions):\n","            final_predictions.append(current_sample_all_predictions[relative_pref_subsequence_k])\n","        else:\n","            print(f\"Attenzione: Sottosequenza preferenziale (start_ts={pref_start_ts_1idx}) fuori dai limiti per sample_id {sample_id}.\")\n","            final_predictions.append(majority_classes[0] if majority_classes else 0) # Default at 0 (no_pain) if there are no valid votes\n","\n","\n","# Generating the submission file\n","\n","pain_level_mapping = {\n","    0: \"no_pain\",\n","    1: \"low_pain\",\n","    2: \"high_pain\"\n","}\n","\n","# Map the predictions into pain levels\n","pain_levels = [pain_level_mapping[pred] for pred in final_predictions]\n","\n","# Create a dataframe for the submission\n","submission_df = pd.DataFrame({\n","    'sample_index': unique_users,\n","    'label': pain_levels\n","})\n","\n","# Name of the sumbmission file\n","submission_filename = 'ale_augmented.csv'\n","\n","# Save the dataframe in a csv format\n","submission_df.to_csv(submission_filename, index=False)\n","\n","print(f\"File di submission '{submission_filename}' creato con successo.\")\n","display(submission_df.head())"]}],"metadata":{"accelerator":"GPU","colab":{"collapsed_sections":["7Gx84yscPhkp","p5UNO2qIiGQH"],"gpuType":"T4","provenance":[]},"kernelspec":{"display_name":"Python 3","name":"python3"},"language_info":{"name":"python"}},"nbformat":4,"nbformat_minor":0}