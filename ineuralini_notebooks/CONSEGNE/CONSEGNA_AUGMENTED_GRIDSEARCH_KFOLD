id":"i-xvF-5qVj6t"},"outputs":[],"source":["from math import floor\n","\n","# REMINDER:\n","WINDOW_SIZE = 20\n","STRIDE = 5\n","BATCH_SIZE = 128\n","N_VAL_USERS = 75\n","\n","\n","def study_subsequence(n_subsequence, X_val, y_val, model):\n","\n","  padding_len = WINDOW_SIZE - 160 % WINDOW_SIZE\n","  padded_len = 160 + padding_len\n","  total_subsequences = floor((padded_len - WINDOW_SIZE) / STRIDE) + 1\n","  total_subsequences = int(total_subsequences)\n","\n","  N_VAL_USERS = X_val.shape[0]/total_subsequences\n","  N_VAL_USERS = int(N_VAL_USERS)\n","\n","  n_sub_backwards = total_subsequences + 1 - n_subsequence\n","\n","  # Calculate the indices of the last sequence for each validation set element\n","  last_sequence_indices = [(i * total_subsequences) - n_sub_backwards for i in range(1, N_VAL_USERS + 1)]\n","\n","  filling = BATCH_SIZE - N_VAL_USERS % BATCH_SIZE\n","  last_sequence_indices_filler = [i for i in range(0, filling)]\n","  last_sequence_indices = last_sequence_indices + last_sequence_indices_filler\n","\n","  # Extract the last sequences from X_val using the calculated indices\n","  X_val_last_sequence = X_val[last_sequence_indices, :, :]\n","  y_val_last_sequence  = y_val[last_sequence_indices]\n","\n","  val_ds   = TensorDataset(torch.from_numpy(X_val_last_sequence), torch.from_numpy(y_val_last_sequence))\n","  val_loader   = make_loader(val_ds, batch_size=BATCH_SIZE, shuffle=False, drop_last=False)\n","\n","  val_preds, val_targets = [], []\n","  with torch.no_grad():  # Disable gradient computation for inference\n","        for xb, yb in val_loader:\n","          xb = xb.to(device)\n","\n","          # Forward pass: get model predictions\n","          logits = model(xb)\n","          preds = logits.argmax(dim=1).cpu().numpy()\n","\n","          # Store batch results\n","          val_preds.append(preds)\n","          val_targets.append(yb.numpy())\n","\n","\n","  val_preds = np.concatenate(val_preds)\n","  val_targets = np.concatenate(val_targets)\n","  val_preds = val_preds[0:N_VAL_USERS]\n","  val_targets = val_targets[0:N_VAL_USERS]\n","\n","  return val_preds, val_targets"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":695},"executionInfo":{"elapsed":538,"status":"ok","timestamp":1763219165710,"user":{"displayName":"Alessandro Romani","userId":"14278664457832964726"},"user_tz":-60},"id":"hBCEOTQRtzQ1","outputId":"6cc38c01-c199-4e00-ec14-3f050ce61750"},"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 800x700 with 2 Axes>"],"image/png":"\n"},"metadata":{}}],"source":["val_preds, val_targets = study_subsequence(16, X_val, y_val, rnn_model) #input should be a number from 1 to 33\n","\n","# Generate confusion matrix for detailed error analysis\n","cm = confusion_matrix(val_targets, val_preds)\n","\n","# Create numeric labels for heatmap annotation\n","labels = np.array([f\"{num}\" for num in cm.flatten()]).reshape(cm.shape)\n","\n","# Visualise confusion matrix\n","plt.figure(figsize=(8, 7))\n","sns.heatmap(cm, annot=labels, fmt='',\n","            cmap='Blues')\n","plt.xlabel('Predicted labels')\n","plt.ylabel('True labels')\n","plt.title('Confusion Matrix — Validation Set')\n","plt.tight_layout()\n","plt.show()"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":595},"executionInfo":{"elapsed":5809,"status":"ok","timestamp":1763128772876,"user":{"displayName":"Alessandro Romani","userId":"14278664457832964726"},"user_tz":-60},"id":"9P8uFVlavi1D","outputId":"3873f686-1ec5-40fe-8aa2-e700a8eaa550"},"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1500x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}}],"source":["from sklearn.metrics import accuracy_score\n","\n","err = []\n","lower_bounds = []\n","upper_bounds = []\n","x_labels = [] # List to store custom x-axis labels\n","\n","# Assuming WINDOW_SIZE and STRIDE are defined in a previous cell\n","# WINDOW_SIZE = 20\n","# STRIDE = 5\n","\n","num_windows = int(floor(160 / STRIDE))\n","\n","for i in range(num_windows):\n","    # Call study_subsequence with 1-based index as it expects\n","    preds, targets = study_subsequence(i+1, X_val, y_val, rnn_model)\n","\n","    # Calculate accuracy and then error (1 - accuracy)\n","    error = 1 - accuracy_score(targets, preds)\n","    err.append(error)\n","\n","    # Calculate lower and upper bounds for the original time steps (0-indexed)\n","    lower_bound = i * STRIDE + 1\n","    upper_bound = lower_bound + WINDOW_SIZE - 1\n","\n","    lower_bounds.append(lower_bound)\n","    upper_bounds.append(upper_bound)\n","\n","    # Create a string label for the x-axis\n","    x_labels.append(f\"{lower_bound}-{upper_bound}\")\n","\n","\n","# Plot the errors\n","plt.figure(figsize=(15, 6)) # Increased figure size for better label readability\n","plt.plot(range(num_windows), err, marker='o', linestyle='-') # Plot against 0-indexed subsequence number\n","\n","plt.xlabel('Original Time Step Range (Lower Bound - Upper Bound)')\n","plt.ylabel('Error Rate (1 - Accuracy)')\n","plt.title('Error Rate vs. Original Time Step Range')\n","\n","# Set custom x-axis ticks and labels\n","plt.xticks(range(num_windows), x_labels, rotation=90) # Use x_labels for ticks, rotate for readability\n","\n","plt.grid(True)\n","\n","# Find the index where the upper bound first exceeds 160 (length of original data)\n","padding_start_index = -1\n","for i, ub in enumerate(upper_bounds):\n","    if ub > 160:\n","        padding_start_index = i\n","        break\n","\n","# If padding exists, add a shaded region and annotation\n","if padding_start_index != -1:\n","    # Shade the area from the start of padding subsequences to the end\n","    plt.axvspan(padding_start_index - 0.5, len(err) - 0.5, color='yellow', alpha=0.2, label='Padding Region')\n","\n","    # Add \"padding\" annotation\n","    # Position the text near the start of the shaded r