D) # Ensure reproducibility of shuffling\n","random.shuffle(unique_users)\n","\n","# Define the number of users for validation set\n","N_VAL_USERS = 75 # You can change this number\n","\n","# Calculate the number of users for the training set\n","n_train_users = len(unique_users) - N_VAL_USERS\n","\n","# Split the shuffled user IDs into training, validation, and test sets\n","train_users = unique_users[:n_train_users]\n","val_users = unique_users[n_train_users:n_train_users + N_VAL_USERS]\n","\n","# Split the dataset into training, validation, and test sets based on user IDs\n","df_train = X_train_mod[X_train_mod['sample_index'].isin(train_users)]\n","df_val = X_train_mod[X_train_mod['sample_index'].isin(val_users)]\n","\n","# Print the shapes of the training, validation, and test sets\n","print(f'Training set shape: {df_train.shape}')\n","print(f'Validation set shape: {df_val.shape}')"]},{"cell_type":"code","execution_count":11,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":186,"status":"ok","timestamp":1763389969913,"user":{"displayName":"Federico Carugati","userId":"11217426867679779751"},"user_tz":-60},"id":"_f41l7pX_JmC","outputId":"5d0a5a3b-f4fa-411e-a812-e22ba3f324dc"},"outputs":[{"output_type":"stream","name":"stdout","text":["Training labels: {'no_pain': 455, 'low_pain': 82, 'high_pain': 49}\n"]}],"source":["# Initialise a dictionary to count occurrences of each activity in the training set\n","training_labels = {\n","    'no_pain': 0,\n","    'low_pain': 0,\n","    'high_pain': 0,\n","}\n","\n","# Count occurrences of each activity for unique IDs in the training set\n","for id in df_train['sample_index'].unique():\n","    label = df_train[df_train['sample_index'] == id]['label'].values[0]\n","    training_labels[label] += 1\n","\n","# Print the distribution of training labels\n","print('Training labels:', training_labels)"]},{"cell_type":"code","execution_count":12,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":18,"status":"ok","timestamp":1763389969948,"user":{"displayName":"Federico Carugati","userId":"11217426867679779751"},"user_tz":-60},"id":"4vfNWwiYeTzL","outputId":"538c9cb8-88e7-4b42-c374-75b8f2997a03"},"outputs":[{"output_type":"stream","name":"stdout","text":["Validation labels: {'no_pain': 56, 'low_pain': 12, 'high_pain': 7}\n"]}],"source":["# Initialise a dictionary to count occurrences of each activity in the validation set\n","val_labels = {\n","    'no_pain': 0,\n","    'low_pain': 0,\n","    'high_pain': 0,\n","}\n","\n","# Count occurrences of each activity for unique IDs in the validation set\n","for id in df_val['sample_index'].unique():\n","    label = df_val[df_val['sample_index'] == id]['label'].values[0]\n","    val_labels[label] += 1\n","\n","# Print the distribution of training labels\n","print('Validation labels:', val_labels)\n"]},{"cell_type":"code","execution_count":13,"metadata":{"id":"ed577kr5F8HQ","executionInfo":{"status":"ok","timestamp":1763389969969,"user_tz":-60,"elapsed":22,"user":{"displayName":"Federico Carugati","userId":"11217426867679779751"}}},"outputs":[],"source":["# Define a mapping of pain values to integer labels\n","label_mapping_pain = {\n","    'no_pain': 0,\n","    'low_pain': 1,\n","    'high_pain': 2,\n","}\n","\n","# Map activity pain levels to integers in the training set\n","df_train['label'] = df_train['label'].map(label_mapping_pain)\n","\n","# Map activity pain levels to integers in the validation set\n","df_val['label'] = df_val['label'].map(label_mapping_pain)"]},{"cell_type":"code","execution_count":14,"metadata":{"id":"CW6EZUugeT5K","executionInfo":{"status":"ok","timestamp":1763389970032,"user_tz":-60,"elapsed":60,"user":{"displayName":"Federico Carugati","userId":"11217426867679779751"}}},"outputs":[],"source":["# Define the columns to be normalised\n","scale_columns = []\n","for i in range(30):\n","    scale_columns.append(f'joint_{i:02d}') # Formatting the column name (es. 'joint_00', 'joint_01')\n","\n","# Calculate the minimum and maximum values from the training data only\n","# we normalize with respect to the training set, as we have always done\n","#this is min-max scaling\n","mins = df_train[scale_columns].min()\n","maxs = df_train[scale_columns].max()\n","\n","# Apply normalisation to the specified columns in all datasets\n","for column in scale_columns:\n","    # Normalise the training set\n","    df_train[column] = (df_train[column] - mins[column]) / (maxs[column] - mins[column])\n","\n","    # Normalise the validation set\n","    df_val[column] = (df_val[column] - mins[column]) / (maxs[column] - mins[column])\n","\n","    # Normalise the test set\n","    X_test[column] = (X_test[column] - mins[column]) / (maxs[column] - mins[column])"]},{"cell_type":"code","execution_count":15,"metadata":{"id":"dynA-LZbIcOt","executionInfo":{"status":"ok","timestamp":1763389970101,"user_tz":-60,"elapsed":67,"user":{"displayName":"Federico Carugati","userId":"11217426867679779751"}}},"outputs":[],"source":["###########################################\n","WINDOW_SIZE = 30\n","STRIDE = 5\n","###########################################"]},{"cell_type":"code","execution_count":16,"metadata":{"id":"CNNlRaXHI3Sl","executionInfo":{"status":"ok","timestamp":1763389970127,"user_tz":-60,"elapsed":46,"user":{"displayName":"Federico Carugati","userId":"11217426867679779751"}}},"outputs":[],"source":["# Define a function to build sequences from the dataset\n","def build_sequences(df, window=20, stride=5):\n","    # Sanity check to ensure the window is divisible by the stride\n","    assert window % stride == 0\n","\n","    # Initialise lists to store sequences and their corresponding labels\n","    dataset = []\n","    labels = []\n","\n","    # Define all columns to be used for building sequences\n","    all_columns = scale_columns + [\"pain_survey_1\", \"pain_survey_2\", \"pain_survey_3\", \"pain_survey_4\", \"n_legs\", \"n_hands\", \"n_eyes\"]\n","\n","\n","    # Iterate over unique IDs in the DataFrame\n","    for id in df['sample_index'].unique():\n","        # Extract sensor data for the current ID\n","        temp = df[df['sample_index'] == id][all_columns].values\n","\n","        # Retrieve the activity label for the current ID\n","        label = df[df['sample_index'] == id]['label'].values[0]\n","\n","        # Calculate padding length to ensure full windows\n","        padding_len = window - len(temp) % window\n","\n","        # Create zero padding and concatenate with the data\n","        # The padding should match the number of columns being used\n","        padding = np.zeros((padding_len, len(all_columns)), dtype='float32')\n","        temp = np.concatenate((temp, padding))\n","\n","\n","        # Build feature windows and associate them with labels\n","        idx = 0\n","        while idx + window <= len(temp):\n","            dataset.append(temp[idx:idx + window])\n","            labels.append(label)\n","            idx += stride\n","\n","    # Convert lists to numpy arrays for further processing\n","    dataset = np.array(dataset)\n","    labels = np.array(labels)\n","\n","    return dataset, labels"]},{"cell_type":"code","execution_count":17,"metadata":{"id":"EdxIgOUnMzBP","executionInfo":{"status":"ok","timestamp":1763389970128,"user_tz":-60,"elapsed":45,"user":{"displayName":"Federico Carugati","userId":"11217426867679779751"}}},"outputs":[],"source":["# Define a function to build sequences from the dataset\n","def build_sequences_test(df, window=20, stride=5):\n","    # Sanity check to ensure the window is divisible by the stride\n","    assert window % stride == 0\n","\n","    # Initialise lists to store sequences and their corresponding labels\n","    dataset = []\n","\n","    # Define all columns to be used for building sequences\n","    all_columns = scale_columns + [\"pain_survey_1\", \"pain_survey_2\", \"pain_survey_3\", \"pain_survey_4\", \"n_legs\", \"n_hands\", \"n_eyes\"]\n","\n","    # Iterate over unique IDs in the DataFrame\n","    for id in df['sample_index'].unique():\n","        # Extract sensor data for the current ID\n","        temp = df[df['sample_index'] == id][all_columns].values\n","\n","        # Calculate padding length to ensure full windows\n","        padding_len = window - len(temp) % window\n","\n","        # Create zero padding and concatenate with the data\n","        # The padding should match the number of columns being used\n","        padding = np.zeros((padding_len, len(all_columns)), dtype='float32')\n","        temp = np.concatenate((temp, padding))\n","\n","        # Build feature windows and associate them with labels\n","        idx = 0\n","        while idx + window <= len(temp):\n","            dataset.append(temp[idx:idx + window])\n","            idx += stride\n","\n","    # Convert lists to numpy arrays for further processing\n","    # dataset = np.array(dataset)\n","\n","    return dataset"]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"c09033c3","executionInfo":{"status":"ok","timestamp":1763389987952,"user_tz":-60,"elapsed":17822,"user":{"displayName":"Federico Carugati","userId":"11217426867679779751"}},"outputId":"9deed29e-f809-4d21-ca40-66945b05a73e"},"source":["# Generate sequences and labels for the training set\n","X_train, y_train = build_sequences(df_train, WINDOW_SIZE, STRIDE)\n","\n","# Generate sequences and labels for the validation set\n","X_val, y_val = build_sequences(df_val, WINDOW_SIZE, STRIDE)\n","\n","# Generate sequences for the test set\n","X_test_windowed = build_sequences_test(X_test, WINDOW_SIZE, STRIDE)\n","\n","\n","# Print the shapes of the generated datasets and their labels\n","print(f\"Training sequences shape: {X_train.shape}, Labels shape: {y_train.shape}\")\n","print(f\"Validation sequences shape: {X_val.shape}, Labels shape: {y_val.shape}\")\n","print(f\"Test sequences shape: {np.array(X_test_windowed).shape}\")\n","\n","# Data augmentation using tsaug\n","!pip install tsaug\n","from tsaug import TimeWarp, Crop, Quantize, Drift\n","\n","# Assuming X_train and y_train are already windowed NumPy arrays\n","\n","def augment_time_series(X_data, y_data, augment_classes, num_augments_per_class):\n","    augmented_X = []\n","    augmented_y = []\n","\n","    # Define the augmentation pipeline\n","    # Removed Crop to maintain consistent sequence length (WINDOW_SIZE)\n","    augmenter = (\n","        TimeWarp(n_speed_change=4, max_speed_ratio=3, seed=SEED) \\\n","        + Drift(max_drift=(0.05), seed=SEED)\n","    )\n","\n","    for class_label in augment_classes:\n","        # Select samples belonging to the current minority class\n","        minority_indices = np.where(y_data == class_label)[0]\n","        X_minority = X_data[minority_indices]\n","        y_minority = y_data[minority_indices]\n","\n","        # Augment each sample in the minority class\n","        for i in range(X_minority.shape[0]):\n","            original_sample = X_minority[i]\n","            # tsaug expects (num_samples, num_timesteps, num_features)\n","            # We augment one sample at a time, so num_samples=1\n","            augmented_samples = augmenter.augment(original_sample[np.newaxis, :, :])\n","\n","            # Dynamically set the number of augmentations per sample based on its class\n","            num_augments = num_augments_per_class.get(class_label, 1)\n","\n","            # Repeat the augmentation 'num_augments' times for each original sample\n","            for _ in range(num_augments):\n","                augmented_X.append(augmented_samples[0]) # Take the first (and only) augmented sample\n","                augmented_y.append(class_label)\n","\n","    if augmented_X:\n","        augmented_X = np.array(augmented_X, dtype=X_data.dtype)\n","        augmented_y = np.array(augmented_y, dtype=y_data.dtype)\n","        print(f\"Shape of augmented X: {augmented_X.shape}\")\n","        print(f\"Shape of augmented y: {augmented_y.shape}\")\n","\n","        # Concatenate augmented data with original data\n","        X_augmented = np.concatenate((X_data, augmented_X), axis=0)\n","        y_augmented = np.concatenate((y_data, augmented_y), axis=0)\n","    else:\n","        X_augmented = X_data\n","        y_augmented = y_data\n","\n","    return X_augmented, y_augmented\n","\n","# Identify minority classes (assuming integer labels 0: no_pain, 1: low_pain, 2: high_pain)\n","# Based on `training_labels`: 'no_pain': 455, 'low_pain': 82, 'high_pain': 49\n","# The label mapping happens later so X_train and y_train have string labels from df_train. I need to make sure this is handled correctly.\n","# Looking at the code for build_sequences, y_train becomes numeric labels AFTER the label_mapping_pain is applied to df_train. Therefore, the y_train in this cell should already be numeric.\n","# So the y_train from build_sequences will indeed be integer labels.\n","minority_classes_for_augmentation = [1, 2] # low_pain (1) and high_pain (2)\n","\n","# Define the number of augmentations for each minority class\n","# Augment 'low_pain' 4 times and 'high_pain' 5 times\n","num_augments_per_class_dict = {1: 4, 2: 6}\n","\n","# Apply augmentation to training data\n","X_train, y_train = augment_time_series(\n","    X_train, y_train,\n","    augment_classes=minority_classes_for_augmentation,\n","    num_augments_per_class=num_augments_per_class_dict\n",")\n","\n","print(f\"Final X_train shape after augmentation: {X_train.shape}\")\n","print(f\"Final y_train shape after augmentation: {y_train.shape}\")\n","\n","# Verify label distribution after augmentation\n","augmented_label_counts = pd.Series(y_train).value_counts().sort_index()\n","print(\"\\nLabel distribution after augmentation:\")\n","print(augmented_label_counts)"],"execution_count":18,"outputs":[{"output_type":"stream","name":"stdout","text":["Training sequences shape: (18166, 30, 37), Labels shape: (18166,)\n","Validation sequences sha