gradient computation for inference\n","    for xb, yb in val_loader:\n","        xb = xb.to(device)\n","\n","        # Forward pass: get model predictions\n","        logits = rnn_model(xb)\n","        preds = logits.argmax(dim=1).cpu().numpy()\n","\n","        # Store batch results\n","        val_preds.append(preds)\n","        val_targets.append(yb.numpy())\n","\n","# Combine all batches into single arrays\n","val_preds = np.concatenate(val_preds)\n","val_targets = np.concatenate(val_targets)\n","\n","# Calculate overall validation metrics\n","val_acc = accuracy_score(val_targets, val_preds)\n","val_prec = precision_score(val_targets, val_preds, average='weighted')\n","val_rec = recall_score(val_targets, val_preds, average='weighted')\n","val_f1 = f1_score(val_targets, val_preds, average='weighted')\n","print(f\"Accuracy over the validation set: {val_acc:.4f}\")\n","print(f\"Precision over the validation set: {val_prec:.4f}\")\n","print(f\"Recall over the validation set: {val_rec:.4f}\")\n","print(f\"F1 score over the validation set: {val_f1:.4f}\")\n","\n","# Generate confusion matrix for detailed error analysis\n","cm = confusion_matrix(val_targets, val_preds)\n","\n","# Create numeric labels for heatmap annotation\n","labels = np.array([f\"{num}\" for num in cm.flatten()]).reshape(cm.shape)\n","\n","# Visualise confusion matrix\n","plt.figure(figsize=(8, 7))\n","sns.heatmap(cm, annot=labels, fmt='',\n","            cmap='Blues')\n","plt.xlabel('Predicted labels')\n","plt.ylabel('True labels')\n","plt.title('Confusion Matrix — Validation Set')\n","plt.tight_layout()\n","plt.show()"]},{"cell_type":"code","execution_count":null,"metadata":{"executionInfo":{"elapsed":9,"status":"ok","timestamp":1763224142818,"user":{"displayName":"Francesco","userId":"16627568446365235794"},"user_tz":-60},"id":"yQMGf2LLp-3w","colab":{"base_uri":"https://localhost:8080/"},"outputId":"883ae146-00d4-4030-f369-3d1062f4d1f6"},"outputs":[{"output_type":"stream","name":"stdout","text":["17\n"]}],"source":["WINDOW_SIZE = 30\n","STRIDE = 10\n","total_subsequences = (160)/STRIDE +1\n","total_subsequences = int(total_subsequences)\n","print(total_subsequences)"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"2FpUc4oTp_EU"},"outputs":[],"source":["from math import floor\n","# @title Study of subsequences\n","\n","BATCH_SIZE = 128\n","N_VAL_USERS = 75\n","\n","def study_subsequence(n_subsequence, X_val, y_val, model):\n","\n","  original_seq_len_per_sample = 160 # Each sample_index has 160 time steps\n","\n","  # Calculate padding using the actual window size used to create X_val\n","  padding_len = (WINDOW_SIZE - (original_seq_len_per_sample % WINDOW_SIZE)) % WINDOW_SIZE\n","  padded_len = original_seq_len_per_sample + padding_len\n","\n","  # Calculate total subsequences PER ORIGINAL SAMPLE using the actual window/stride\n","  total_subsequences_per_sample = floor((padded_len - WINDOW_SIZE) / STRIDE) + 1\n","  total_subsequences_per_sample = int(total_subsequences_per_sample)\n","\n","  # The N_VAL_USERS should be derived from X_val.shape[0] / total_subsequences_per_sample\n","  # X_val.shape[0] is the total number of subsequences for all validation users\n","  # We use the original N_VAL_USERS to ensure consistency\n","  N_VAL_USERS_FROM_X_VAL = X_val.shape[0] // total_subsequences_per_sample\n","\n","  n_sub_backwards = total_subsequences_per_sample + 1 - n_subsequence\n","\n","  # Calculate the indices of the last sequence for each validation set element\n","  # These are the indices within the X_val array, which contains subsequences for all users stacked\n","  last_sequence_indices = [(i * total_subsequences_per_sample) - n_sub_backwards for i in range(1, N_VAL_USERS_FROM_X_VAL + 1)]\n","\n","  filling = BATCH_SIZE - N_VAL_USERS_FROM_X_VAL % BATCH_SIZE\n","  last_sequence_indices_filler = [i for i in range(0, filling)]\n","  last_sequence_indices = last_sequence_indices + last_sequence_indices_filler\n","\n","  # Extract the last sequences from X_val using the calculated indices\n","  X_val_last_sequence = X_val[last_sequence_indices, :, :]\n","  y_val_last_sequence  = y_val[last_sequence_indices]\n","\n","  val_ds   = TensorDataset(torch.from_numpy(X_val_last_sequence), torch.from_numpy(y_val_last_sequence))\n","  val_loader   = make_loader(val_ds, batch_size=BATCH_SIZE, shuffle=False, drop_last=False)\n","\n","  val_preds, val_targets = [], []\n","  with torch.no_grad():  # Disable gradient computation for inference\n","        for xb, yb in val_loader:\n","          xb = xb.to(device)\n","\n","          # Forward pass: get model predictions\n","          logits = model(xb)\n","          preds = logits.argmax(dim=1).cpu().numpy()\n","\n","          # Store batch results\n","          val_preds.append(preds)\n","          val_targets.append(yb.numpy())\n","\n","\n","  val_preds = np.concatenate(val_preds)\n","  val_targets = np.concatenate(val_targets)\n","  val_preds = val_preds[0:N_VAL_USERS_FROM_X_VAL]\n","  val_targets = val_targets[0:N_VAL_USERS_FROM_X_VAL]\n","\n","  return val_preds, val_targets"]},{"cell_type":"code","execution_count":null,"metadata":{"executionInfo":{"elapsed":416,"status":"ok","timestamp":1763224146776,"user":{"displayName":"Francesco","userId":"16627568446365235794"},"user_tz":-60},"id":"hdIprVszqShy","colab":{"base_uri":"https://localhost:8080/","height":695},"outputId":"a87ebfff-6a75-4501-9e55-23adb9e65a2d"},"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 800x700 with 2 Axes>"],"image/png":"\n"},"metadata":{}}],"source":["val_preds, val_targets = study_subsequence(7, X_val, y_val, rnn_model) #input should be a number from 1 to 33 (in case the window is 30)\n","\n","# Generate confusion matrix for detailed error analysis\n","cm = confusion_matrix(val_targets, val_preds)\n","\n","# Create numeric labels for heatmap annotation\n","labels = np.array([f\"{num}\" for num in cm.flatten()]).reshape(cm.shape)\n","\n","# Visualise confusion matrix\n","plt.figure(figsize=(8, 7))\n","sns.heatmap(cm, annot=labels, fmt='',\n","            cmap='Blues')\n","plt.xlabel('Predicted labels')\n","plt.ylabel('True labels')\n","plt.title('Confusion Matrix — Validation Set')\n","plt.tight_layout()\n","plt.show()"]},{"cell_type":"code","execution_count":null,"metadata":{"executionInfo":{"elapsed":2828,"status":"ok","timestamp":1763224153884,"user":{"displayName":"Francesco","userId":"16627568446365235794"},"user_tz":-60},"id":"pyctPq4Xq7VM","colab":{"base_uri":"https://localhost:8080/","height":519},"outputId":"28009343-302b-4d1d-b927-08abe8f78a6a"},"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1500x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}}],"source":["from sklearn.metrics import confusion_matrix\n","import numpy as np # Ensure numpy is imported for array operations\n","\n","acc_0 = []\n","acc_1 = []\n","acc_2 = []\n","lower_bounds = []\n","upper_bounds = []\n","x_labels = [] # List to store custom x-axis labels\n","\n","\n","# Recalculate total_subsequences based on the actual X_val generation parameters\n","# This ensures the loop runs for the correct number of subsequences (16 in this case)\n","padding_len_for_xval = (WINDOW_SIZE - (160 % WINDOW_SIZE)) % WINDOW_SIZE\n","padded_len_for_xval = 160 + padding_len_for_xval\n","total_subsequences_to_plot = floor((padded_len_for_xval - WINDOW_SIZE) / STRIDE) + 1\n","total_subsequences_to_plot = int(total_subsequences_to_plot)\n","\n","for i in range(total_subsequences_to_plot): # Iterate based on actual number of subsequences per sample (which is 16)\n","    # Call study_subsequence with 1-based index as it expects\n","    preds, targets = study_subsequence(i+1, X_val, y_val, rnn_model)\n","\n","    # Calculate confusion matrix for the current subsequence\n","    cm = confusion_matrix(targets, preds, labels=[0, 1, 2])\n","\n","    # Calculate per-class accuracy manually from the confusion matrix\n","    total_samples = np.sum(cm)\n","    if total_samples == 0: # Handle empty target/prediction sets\n","        acc_0.append(0.0)\n","        acc_1.append(0.0)\n","        acc_2.append(0.0)\n","    else:\n","        # Accuracy for Class 0\n","        tp_0 = cm[0, 0]\n","        tn_0 = np.sum(cm[1:, 1:]) # Sum of all elements not in row 0 and not in column 0\n","        acc_0.append((tp_0 + tn_0) / total_samples)\n","\n","        # Accuracy for Class 1\n","        tp_1 = cm[1, 1]\n","        tn_1 = cm[0,0] + cm[0,2] + cm[2,0] + cm[2,2] # Sum of elements not in row 1 and not in column 1\n","        acc_1.append((tp_1 + tn_1) / total_samples)\n","\n","        # Accuracy for Class 2\n","        tp_2 = cm[2, 2]\n","        tn_2 = np.sum(cm[:2, :2]) # Sum of elements not in row 2 and not in column 2\n","        acc_2.append((tp_2 + tn_2) / total_samples)\n","\n","    # Calculate lower and upper bounds for the original time steps (0-indexed)\n","    # Use ACTUAL_XVAL_STRIDE and ACTUAL_XVAL_WINDOW_SIZE for accurate labels\n","    lower_bound = i * STRIDE + 1\n","    upper_bound = lower_bound + WINDOW_SIZE - 1\n","\n","    lower_bounds.append(lower_bound)\n","    upper_bounds.append(upper_bound)\n","\n","    # Create a string label for the x-axis\n","    x_labels.append(f\"{lower_bound}-{upper_bound}\")\n","\n","\n","# Plot the errors\n","plt.figure(figsize=(15, 6)) # Increased figure size for better label readability\n","plt.plot(range(total_subsequences_to_plot), acc_0, marker='o', linestyle='-', label='Accuracy Class 0')\n","plt.plot(range(total_subsequences_to_plot), acc_1, marker='o', linestyle='-', label='Accuracy Class 1')\n","plt.plot(range(total_subsequences_to_plot), acc_2, marker='o', linestyle='-', label='Accuracy Class 2')\n","\n","plt.xlabel('Original Time Step Range (Lower Bound - Upper Bound)')\n","plt.ylabel('Accuracy') # Changed label to Accuracy\n","plt.title('Accuracy per Class vs. Original Time Step Range') # Changed title to Accuracy per Class\n","\n","# Set custom x-axis ticks and labels\n","plt.xticks(range(total_subsequences_to_plot), x_labels, rotation=90) # Use x_labels for ticks, rotate for readability\n","\n","plt.grid(True)\n","\n","# Find the index where the upper bound first exceeds original_seq_len (length of original data)\n","padding_start_index = -1\n","for i, ub in enumerate(upper_bounds):\n","    if ub > 160:\n","        padding_start_index = i\n","        break\n","\n","# If padding exists, add a shaded region and annotation\n","if padding_start_index != -1:\n","    # Shade the area from the start of padding subsequences to the end\n","    plt.axvspan(padding_start_index - 0.5, len(acc_0) - 0.5, color='yellow', alpha=0.2, label='Padding Region')\n","\n","    # Add \"padding\" annotation\n","    # Position the text near the start of the shaded region\n","    plt.text(padding_start_index + 0.5, np.max(acc_0) * 0.9, 'Padding', # Use np.max for current list\n","             fontsize=12, color='gray', rotation=90, verticalalignment='top')\n","\n","plt.legend()\n","plt.tight_layout() # Adjust layout to prevent labels overlapping\n","plt.show()"]},{"cell_type":"markdown","metadata":{"id":"6dGybfb3km4d"},"source":["#**TESTING**"]},{"cell_type":"code","execution_count":null,"metadata":{"executionInfo":{"elapsed":1148,"status":"ok","timestamp":1763224243520,"user":{"displayName":"Francesco","userId":"16627568446365235794"},"user_tz":-60},"id":"Q_n8HJIHHdl2","colab":{"base_uri":"https://localhost:8080/"},"outputId":"5ce21d36-9848-4075-db0e-11db440f01c6"},"outputs":[{"output_type":"stream","name":"stdout","text":["Training set shape: (93760, 40)\n","Validation set shape: (12000, 40)\n"]}],"source":["#Just to make this part of the notebook a little bit more independent from the rest of it, we reimport the datasets and we reprocesse them\n","#(as we did at the beginning of this notebook)\n","\n","X_train = pd.read_csv('pirate_pain_train.csv')\n","y_train = pd.read_csv('pirate_pain_train_labels.csv')\n","\n","N_VAL_USERS = 75\n","\n","X_train =